<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Thi Kinh Thánh: Tin Lành Ma-thi-ơ</title>
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#181825">
  <style>
    :root {
      --bg: #11111b;
      --card: #1e1e2e;
      --accent: #89b4fa;
      --text: #cdd6f4;
      --dim: #a6adc8;
      --green: #a6e3a1;
      --green-bg: rgba(166, 227, 161, 0.18);
      --red: #f38ba8;
      --red-bg: rgba(243, 139, 168, 0.18);
      --border: #313244;
      --opt-bg: #181825;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      padding: 16px;
      padding-top: max(16px, env(safe-area-inset-top));
      padding-bottom: max(16px, env(safe-area-inset-bottom));
      max-width: 540px;
      margin: 0 auto;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      text-align: center;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }
    .exam-title { font-size: 1.15rem; font-weight: bold; color: var(--accent); text-transform: uppercase; }
    .exam-sub { font-size: 0.8rem; color: var(--dim); margin-top: 2px; }

    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      font-size: 0.88rem;
      font-weight: 600;
    }
    .score-badge { color: #f9e2af; }

    .progress-wrap {
      width: 100%;
      height: 6px;
      background: #313244;
      border-radius: 3px;
      overflow: hidden;
      margin-bottom: 16px;
    }
    .progress-bar {
      height: 100%;
      width: 0%;
      background: var(--accent);
      transition: width 0.3s ease;
    }

    .quiz-card {
      background: var(--card);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: border-color 0.2s, transform 0.2s;
    }

    .shake-anim {
      animation: shake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
      border-color: var(--red) !important;
    }
    @keyframes shake {
      10%, 90% { transform: translate3d(-3px, 0, 0); }
      20%, 80% { transform: translate3d(5px, 0, 0); }
      30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
      40%, 60% { transform: translate3d(6px, 0, 0); }
    }

    .correct-anim {
      animation: popGreen 0.6s ease-out both;
      border-color: var(--green) !important;
    }
    @keyframes popGreen {
      0% { transform: scale(1); box-shadow: 0 0 0 rgba(166, 227, 161, 0); }
      40% { transform: scale(1.02); box-shadow: 0 0 25px rgba(166, 227, 161, 0.4); }
      100% { transform: scale(1); }
    }

    .q-number {
      font-size: 0.8rem;
      color: var(--accent);
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .q-text {
      font-size: 1.1rem;
      font-weight: 600;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .options-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .opt-btn {
      background: var(--opt-bg);
      border: 1.5px solid var(--border);
      border-radius: 12px;
      padding: 14px 16px;
      color: var(--text);
      font-size: 0.95rem;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 12px;
      line-height: 1.4;
      transition: all 0.15s ease;
    }
    .opt-btn:active { transform: scale(0.98); }
    .opt-tag {
      font-weight: bold;
      color: var(--accent);
      background: rgba(137, 180, 250, 0.15);
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .opt-btn.correct {
      background: var(--green-bg);
      border-color: var(--green);
      color: var(--green);
      font-weight: bold;
    }
    .opt-btn.correct .opt-tag {
      background: var(--green);
      color: #11111b;
    }
    .opt-btn.wrong {
      background: var(--red-bg);
      border-color: var(--red);
      color: var(--red);
    }
    .opt-btn.wrong .opt-tag {
      background: var(--red);
      color: #11111b;
    }

    /* Modal Chế Giễu */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 999;
      padding: 20px;
      backdrop-filter: blur(4px);
    }
    .modal-box {
      background: #181825;
      border: 2px solid var(--red);
      border-radius: 16px;
      padding: 24px 20px;
      text-align: center;
      width: 100%;
      max-width: 400px;
      animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popIn {
      0% { transform: scale(0.7); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .mock-title { font-size: 1.35rem; font-weight: 900; color: var(--red); margin-bottom: 8px; }
    .mock-desc { font-size: 0.95rem; color: var(--dim); margin-bottom: 12px; }
    .correct-info {
      background: #11111b;
      padding: 12px;
      border-radius: 8px;
      border: 1px dashed var(--border);
      color: var(--green);
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 20px;
      text-align: left;
    }
    .btn-next-modal {
      background: var(--red);
      color: #11111b;
      border: none;
      padding: 12px;
      border-radius: 10px;
      font-weight: bold;
      font-size: 1rem;
      width: 100%;
      cursor: pointer;
    }

    /* Màn hình tổng kết */
    .summary-card {
      background: var(--card);
      border-radius: 16px;
      border: 1px solid var(--border);
      padding: 24px 18px;
      text-align: center;
      display: none;
      flex-direction: column;
      gap: 16px;
    }
    .score-circle {
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--accent);
      margin: 10px 0;
    }
    .btn-restart {
      background: var(--accent);
      color: #11111b;
      border: none;
      padding: 14px;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
    }
    .wrong-review-box {
      text-align: left;
      max-height: 250px;
      overflow-y: auto;
      background: #11111b;
      border-radius: 10px;
      padding: 12px;
      font-size: 0.85rem;
      line-height: 1.6;
    }
  </style>
</head>
<body>

  <header>
    <div class="exam-title">Đề Thi Tin Lành Ma-thi-ơ</div>
    <div class="exam-sub">Bản truyền thống 1925 • 30 câu ngẫu nhiên</div>
  </header>

  <div class="status-bar">
    <span id="qCounter">Câu 1 / 30</span>
    <span class="score-badge" id="scoreTrack">Điểm: 0 / 60</span>
  </div>

  <div class="progress-wrap">
    <div class="progress-bar" id="pBar"></div>
  </div>

  <!-- Khung câu hỏi -->
  <div class="quiz-card" id="quizCard">
    <div>
      <div class="q-number" id="qCategory">Câu hỏi</div>
      <div class="q-text" id="qTitle">Đang chuẩn bị đề thi...</div>
    </div>

    <div class="options-list" id="optionsBox"></div>
  </div>

